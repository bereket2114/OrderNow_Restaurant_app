# Frontend API base URL (public backend origin only; do not append /api).
# Local development: create .env.local and set VITE_API_URL=http://localhost:5000
# Vercel production: set VITE_API_URL in Project Settings > Environment Variables
# to your deployed Express backend origin, for example https://your-api.example.com

VITE_API_URL=https://localhost:5000   or if you deploy both your backend and frontend file use the backend project URL in vercel env. variable section