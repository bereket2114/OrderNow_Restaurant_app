# Backend server
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Frontend URL and exact allowed browser origins (comma-separated)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Set this to the same exact frontend origin(s) when deployed.
# Backend API URL is configured separately as VITE_API_URL in the frontend environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chapa v1 hosted checkout (server-side secret only)
CHAPA_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=<your_chapa_secret_key>

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>

# Admin password hash generated with: npm run hash-admin-password
ADMIN_PASSWORD_HASH=<generated_scrypt_hash>

# Cookie policy: use none for cross-site production hosting over HTTPS;
# use lax for local development or same-site deployments. The backend falls back to lax when not HTTPS.
COOKIE_SAME_SITE=none
